# Sahaayak Environment Variables
# Do not place real secrets in this file.

# SQLite Database path
DATABASE_URL=sqlite:///sahaayak.db

# If using any external mapping API (e.g. Mapbox, Google Maps) - Optional for demo
MAP_API_KEY=your_map_api_key_here

# Secret key for potential JWT or sessions in future
SECRET_KEY=demo_secret_key_123

# Admin demo credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo_admin_password
